---
/**
 * 主题切换器：在 textmode / erudite / paper / retypeset 之间跳转，
 * 保持当前浏览位置（首页 / 卷 / 文章）。
 */

import { themeUrl, type ThemeId } from "./theme-routes";

type Props = {
  current: ThemeId;
  volume?: number;
  slug?: string;
  /** textmode 页面使用等宽终端风格变体（避开右下角返回顶部按钮） */
  variant?: "default" | "textmode";
};

const props = Astro.props;

const themes: Array<{ id: ThemeId; label: string }> = [
  { id: "textmode", label: "Textmode" },
  { id: "erudite", label: "Erudite" },
  { id: "paper", label: "Paper" },
  { id: "retypeset", label: "Retypeset" }
];
---

<nav
  class="theme-switcher"
  data-variant={props.variant ?? "default"}
  aria-label="主题风格切换"
>
  {
    themes.map((theme) => (
      <a
        class:list={{ link: true, active: theme.id === props.current }}
        href={themeUrl(theme.id, props.volume, props.slug)}
        aria-current={theme.id === props.current ? "page" : undefined}
      >
        {theme.label}
      </a>
    ))
  }
</nav>

<style>
  .theme-switcher {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.5rem;
    border-radius: 999px;
    backdrop-filter: blur(8px);
    background: color-mix(in srgb, canvastext 6%, transparent);
    box-shadow: 0 1px 8px rgb(0 0 0 / 12%);
    font-size: 0.72rem;
    line-height: 1;
  }

  .link {
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    text-decoration: none;
    opacity: 0.65;
    transition:
      opacity 0.15s ease,
      background-color 0.15s ease;
  }

  .link:hover {
    opacity: 1;
  }

  .link.active {
    opacity: 1;
    font-weight: 600;
    background: color-mix(in srgb, canvastext 10%, transparent);
  }

  /* textmode 终端风格变体：等宽字体 + ANSI 边框，位于返回顶部按钮上方 */
  .theme-switcher[data-variant="textmode"] {
    right: 12px;
    bottom: 48px;
    gap: 0;
    padding: 0;
    border-radius: 0;
    border: 1px solid var(--ansi-bright-black);
    background: var(--bg);
    backdrop-filter: none;
    box-shadow: none;
    font-family: var(--text-font);
    font-size: var(--text-size);
    line-height: 1.2;
  }

  .theme-switcher[data-variant="textmode"] .link {
    padding: 4px 10px;
    border-radius: 0;
    color: var(--ansi-cyan);
    opacity: 0.6;
  }

  .theme-switcher[data-variant="textmode"] .link:hover {
    color: var(--link);
    background: var(--link-hover-bg);
    opacity: 1;
  }

  .theme-switcher[data-variant="textmode"] .link.active {
    color: var(--link);
    background: var(--link-hover-bg);
    font-weight: normal;
    text-decoration: underline;
  }
</style>
