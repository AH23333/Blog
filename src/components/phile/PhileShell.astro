---
import type { Phile } from "../../modules/philes/model";
import {
  renderPhileBodyBlocks,
  renderPhileBodyBlocksLazy,
  renderPhileFooterPre,
  renderPhileHeader,
  shouldUseLazyLoad
} from "../../modules/philes/render";
import { renderRedactedBody } from "../../modules/philes/redacted";

type Props = {
  phile: Phile;
};

const phile = Astro.props.phile;
const header = renderPhileHeader(phile);
const isRedacted = phile.data.redacted || (phile.body ?? "").trim().length === 0;

// 判断是否使用懒加载
const useLazyLoad = !isRedacted && shouldUseLazyLoad(phile);

// 根据是否懒加载选择渲染方式
const lazyResult = useLazyLoad ? await renderPhileBodyBlocksLazy(phile) : null;
const bodyBlocks = useLazyLoad ? [] : (isRedacted ? [] : await renderPhileBodyBlocks(phile));

// 判断是否有图片和 Mermaid
const hasImages = useLazyLoad ? (lazyResult?.hasImages ?? false) : bodyBlocks.some(
  (block) => block.kind === "image" || (block.kind === "text" && /<img[\s>]/i.test(block.html))
);
const hasMermaid = useLazyLoad ? (lazyResult?.hasMermaid ?? false) : bodyBlocks.some(
  (block) => block.kind === "text" && block.html.includes('class="mermaid"')
);
const redactedHtml = isRedacted ? renderRedactedBody(phile) : undefined;
const footerHtml = renderPhileFooterPre(phile);
---

<article class="textmode-wrap phile-wrap">
  <header
    class="phile-header"
    style={`--phile-meta-lines: ${header.metaLineCount}`}
  >
    <pre
      class="textmode-pre phile-pre phile-header-side"
      set:html={header.sideHtml}
    ></pre>
    <pre class="textmode-pre phile-pre phile-header-meta" set:html={header.metaHtml}></pre>
  </header>
  {
    redactedHtml ? (
      <pre class="textmode-pre phile-pre phile-body-pre phile-redacted-pre" set:html={redactedHtml}></pre>
    ) : useLazyLoad && lazyResult ? (
      <>
        <!-- 首屏渲染的内容 -->
        <div class="lazy-initial-content" set:html={lazyResult.initialHtml}></div>
        <!-- 待加载的内容（存储在 template 中） -->
        <div class="lazy-pending-content" set:html={lazyResult.pendingHtml}></div>
      </>
    ) : bodyBlocks.map((block) =>
      block.kind === "image" ? (
        <div class="phile-media" set:html={block.html}></div>
      ) : block.kind === "math" ? (
        <div class="phile-media" set:html={block.html}></div>
      ) : (
        <div class="textmode-pre phile-body" set:html={block.html}></div>
      )
    )
  }
  <pre class="textmode-pre phile-pre phile-footer-pre" set:html={footerHtml}></pre>
</article>

{
  hasImages && (
    <script>
      import { installImageLightbox } from "../../modules/textmode/lightbox/images";

      // 等待打字机动画完成后再初始化图片灯箱，
      // 避免打字机重建 DOM 时销毁已绑定的触发按钮（表格内图片位于 .phile-body 中）
      function whenTypewriterDone(): Promise<void> {
        return new Promise((resolve) => {
          if (window.__typewriterDone) {
            resolve();
            return;
          }
          const handler = () => {
            window.removeEventListener("typewriter-done", handler);
            resolve();
          };
          window.addEventListener("typewriter-done", handler);
          // 兜底：若 8 秒内打字机未触发（如无 .textmode-pre 元素），直接初始化
          setTimeout(() => {
            window.removeEventListener("typewriter-done", handler);
            resolve();
          }, 8000);
        });
      }

      whenTypewriterDone().then(() => {
        installImageLightbox();
      });
    </script>
  )
}
{
  hasMermaid && (
    <script>
      import { initMermaidDiagrams } from "../../modules/textmode/mermaid/init";
      import { installMermaidLightbox } from "../../modules/textmode/lightbox/mermaid";

      // 等待打字机动画完成后再初始化 mermaid，
      // 避免打字机清除 DOM 时销毁未处理的图表元素
      function whenTypewriterDone(): Promise<void> {
        return new Promise((resolve) => {
          if (window.__typewriterDone) {
            resolve();
            return;
          }
          const handler = () => {
            window.removeEventListener("typewriter-done", handler);
            resolve();
          };
          window.addEventListener("typewriter-done", handler);
          // 兜底：若 8 秒内打字机未触发（如无 .textmode-pre 元素），直接初始化
          setTimeout(() => {
            window.removeEventListener("typewriter-done", handler);
            resolve();
          }, 8000);
        });
      }

      whenTypewriterDone().then(() => {
        initMermaidDiagrams().then(() => {
          installMermaidLightbox();
        });
      });
    </script>
  )
}

{
  useLazyLoad && (
    <script>
      import { initLazyRender, getPerformanceReport } from "../../modules/lazy/runtime";

      // 等待首屏打字机完成后初始化懒加载
      function whenTypewriterDone(): Promise<void> {
        return new Promise((resolve) => {
          if (window.__typewriterDone) {
            resolve();
            return;
          }
          const handler = () => {
            window.removeEventListener("typewriter-done", handler);
            resolve();
          };
          window.addEventListener("typewriter-done", handler);
          // 兜底：若 5 秒内打字机未触发，直接初始化
          setTimeout(() => {
            window.removeEventListener("typewriter-done", handler);
            resolve();
          }, 5000);
        });
      }

      whenTypewriterDone().then(() => {
        initLazyRender();

        // 开发环境下输出性能报告
        if (import.meta.env.DEV) {
          setInterval(() => {
            const report = getPerformanceReport();
            console.log("[LazyRender] Performance report:", report);
          }, 30000);
        }
      });
    </script>
  )
}