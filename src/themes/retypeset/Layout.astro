---
/**
 * retypeset Layout（模板 Layout.astro + Head.astro 移植）。
 * 容器数学：mobile mx-auto max-w-51.462rem + p-[min(7.25vw,3.731rem)] y-2.5rem；
 * lg mx-[max(5.75rem,50vw-34.25rem)] my-20 max-w-[min(75vw-16rem,44rem)] p-0。
 */

import katexCssUrl from "katex/dist/katex.min.css?url";
import { siteConfig } from "../../config";
import ThemeSwitcher from "../../modules/themes/ThemeSwitcher.astro";
import "../../modules/themes/content.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Navbar from "./Navbar.astro";
import ThemeToggle from "./ThemeToggle.astro";
import earlySummerSubset from "./fonts/EarlySummer-VF-Split/EarlySummer-VF-Subset.woff2?url";
import snellBlack from "./fonts/Snell-Black-SF.woff2?url";
import snellBold from "./fonts/Snell-Bold-SF.woff2?url";
import stixItalic from "./fonts/STIX-Italic-VF.woff2?url";
import stix from "./fonts/STIX-VF.woff2?url";
import "./styles.css";

type Props = {
  title: string;
  description?: string;
  /** 主站等价路径，用于 canonical 与 og:url */
  canonicalPath: string;
  pageType?: "website" | "article";
  publishedTime?: Date;
  volume?: number;
  slug?: string;
  /** 页眉变体：首页大标题 / 文章页小标题 */
  variant?: "home" | "article";
  /** 是否为主题首页（导航高亮） */
  isHome?: boolean;
};

const props = Astro.props;
const isArticle = props.variant === "article";

const pageTitle = `${props.title} :: ${siteConfig.name}`;
const description = props.description ?? siteConfig.description;
const canonicalUrl = `https://www.cubeyond.net${props.canonicalPath}`;
const pageType = props.pageType ?? "website";
const lightMode = "#f4f3f6";
const darkMode = "#3a383f";
---

<!doctype html>
<html lang="zh-CN" class:list={[{ "scroll-smooth": isArticle }]}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl} />
    {
      props.publishedTime && (
        <meta property="article:published_time" content={props.publishedTime.toISOString()} />
      )
    }
    <meta name="theme-color" content={lightMode} />
    <noscript>
      <style>
        .lazy-list-sentinel {
          display: none !important;
        }
      </style>
    </noscript>
    <link rel="stylesheet" href={katexCssUrl} />
    <link rel="preload" href={earlySummerSubset} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={snellBlack} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={snellBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={stix} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={stixItalic} as="font" type="font/woff2" crossorigin />
    <script
      is:inline
      define:vars={{
        lightMode,
        darkMode,
      }}
    >
      (function () {
        // 主题初始化：localStorage 优先，默认浅色（模板 defaultMode: light）
        function initTheme() {
          var stored = localStorage.getItem("theme");
          var isDark = stored === "dark";
          document.documentElement.classList.toggle("dark", isDark);

          var meta = document.head.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute("content", isDark ? darkMode : lightMode);
          }
        }

        // reduce-motion：系统偏好或不支持 View Transitions 时关闭动画
        function initMotionPref() {
          var prefersReduced = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          var supportsVT = "startViewTransition" in document;
          document.documentElement.classList.toggle(
            "reduce-motion",
            prefersReduced || !supportsVT,
          );
        }

        initTheme();
        initMotionPref();
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <Header variant={props.variant ?? "home"} />
      <Navbar isArticle={isArticle} isHome={props.isHome ?? false} volume={props.volume} slug={props.slug} />
      <main class="shell-main">
        <slot />
      </main>
      <Footer volume={props.volume} slug={props.slug} />
    </div>

    <ThemeToggle />
    <ThemeSwitcher current="retypeset" volume={props.volume} slug={props.slug} />

    <script>
      import { initAnchorReseek } from "../../modules/themes/anchor-reseek";
      import { initThemeLazyLists } from "../../modules/themes/lazy-list-client";
      import { initThemeMermaid } from "../../modules/themes/mermaid-client";
      import { installImageLightbox } from "../../modules/textmode/lightbox/images";

      installImageLightbox();

      // retypeset 文章页为 scroll-behavior: smooth，锚点动画期间上方懒渲染
      // 内容长高会让动画落在陈旧位置——点击锚点后短时间重寻位到目标
      initAnchorReseek();

      // 列表分批懒加载（无批次时为空操作）
      initThemeLazyLists();

      // mermaid 逐图懒渲染，渲染完成时自动安装对应灯箱
      initThemeMermaid("retypeset");
    </script>
  </body>
</html>

<style>
  .shell {
    margin-inline: auto;
    max-width: 51.462rem;
    width: 100%;
    min-height: 100dvh;
    padding: 2.5rem min(7.25vw, 3.731rem);
  }

  .shell-main {
    margin-bottom: 3rem;
  }

  @media (min-width: 64rem) {
    .shell {
      margin-inline: max(5.75rem, calc(50vw - 34.25rem));
      margin-block: 5rem;
      max-width: min(calc(75vw - 16rem), 44rem);
      min-height: 100%;
      padding: 0;
    }
  }
</style>
