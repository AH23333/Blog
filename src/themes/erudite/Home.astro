---
import type { Volume } from "../../modules/volumes/model";
import Layout from "./Layout.astro";
import { siteConfig } from "../../config";

type Props = {
  volumes: Volume[];
};

const props = Astro.props;
---

<Layout title="首页" canonicalPath="/">
  <section class="home-hero">
    <h1>{siteConfig.name}</h1>
    <p class="hero-sub">{siteConfig.description}</p>
  </section>

  <ul class="volume-list">
    {
      props.volumes.map((volume) => (
        <li>
          <a href={`/themes/erudite/volume/${volume.number}/`}>
            Volume {volume.number}
          </a>
          <volume-meta>
            <span>{volume.philes.length} 篇文章</span>
            <span>
              最近更新{" "}
              {volume.philes
                .map((p) => p.data.date)
                .reduce((a, b) => (a > b ? a : b))
                .toISOString()
                .slice(0, 10)}
            </span>
          </volume-meta>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .home-hero {
    margin-block-end: var(--space-l);
  }

  .home-hero h1 {
    font-size: var(--step-3);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
  }

  .home-hero .hero-sub {
    margin-block-start: var(--space-3xs);
    color: var(--muted-foreground);
  }

  .volume-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .volume-list li {
    display: flex;
    flex-direction: column;
  }

  .volume-list li > a {
    font-size: var(--step-1);
    line-height: calc(var(--leading-offset) + 1em);
    font-weight: var(--font-weight-medium);
    width: fit-content;
  }

  volume-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  volume-meta span + span::before {
    content: "·";
    margin-inline-end: var(--space-3xs);
  }
</style>
