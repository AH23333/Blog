---
/**
 * 左侧边栏（模板 Sidebar.astro 移植）：
 * 站点标题 + 导航（Home / 面包屑 / Textmode / GitHub）+ 主题切换。
 */
import { siteConfig } from "../../config";
import { themeUrl } from "../../modules/themes/theme-routes";
import ThemeToggle from "./ThemeToggle.astro";

type Props = {
  crumbs?: { label: string; href: string }[];
  volume?: number;
  slug?: string;
};

const { crumbs = [], volume, slug } = Astro.props;
const textmodeHref = themeUrl("textmode", volume, slug);
---

<aside data-bar>
  <sidebar-inner>
    <a href="/themes/erudite/">{siteConfig.name}</a>
    <nav>
      <ul>
        <li>
          <a href="/themes/erudite/">Home</a>
          {
            crumbs.length > 0 && (
              <ul>
                {crumbs.map((crumb, i) => (
                  <li data-depth={i ? 1 : undefined}>
                    <a
                      href={crumb.href}
                      aria-current={i === crumbs.length - 1 ? "page" : undefined}
                    >
                      {crumb.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </li>
        <li><a href={textmodeHref}>Textmode</a></li>
        <li>
          <a href="https://github.com/AH23333/Blog" rel="noreferrer">GitHub</a>
        </li>
      </ul>
    </nav>
  </sidebar-inner>
  <sidebar-toggle>
    <ThemeToggle />
  </sidebar-toggle>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));
  }

  @media (width < 64rem) {
    aside {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  sidebar-inner > a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-weight: var(--font-weight-medium);
    font-size: var(--step-0);
    color: var(--foreground);
    text-decoration-line: none;
  }

  sidebar-inner > a:hover {
    text-decoration-line: underline;
  }

  @media (width < 64rem) {
    sidebar-inner {
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    font-size: var(--step--1);
  }

  nav a {
    display: block;
    color: var(--muted-foreground);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--foreground);
  }

  nav ul ul {
    margin-block-start: var(--space-3xs);
  }

  nav ul ul a {
    margin-inline-start: var(--space-xs);
  }

  nav li[data-depth="1"] a {
    margin-inline-start: calc(2 * var(--space-xs));
  }

  @media (width < 64rem) {
    nav ul {
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }

    nav ul ul {
      display: none;
    }

    nav li:has(> ul) > a {
      color: var(--foreground);
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;
  }

  @media (width < 64rem) {
    sidebar-toggle {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
    }
  }
</style>
