---
/**
 * paper Layout（模板 Layout.astro + PostLayout.astro 合并移植）。
 * data-theme + .dark 双通道明暗切换；app-layout = 48rem 居中容器由各页 main 承载。
 */

import katexCssUrl from "katex/dist/katex.min.css?url";
import { siteConfig } from "../../config";
import ThemeSwitcher from "../../modules/themes/ThemeSwitcher.astro";
import "../../modules/themes/content.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import "./styles.css";

type Props = {
  title: string;
  description?: string;
  /** 主站等价路径，用于 canonical 与 og:url */
  canonicalPath: string;
  pageType?: "website" | "article";
  publishedTime?: Date;
  volume?: number;
  slug?: string;
};

const props = Astro.props;

const pageTitle = `${props.title} :: ${siteConfig.name}`;
const description = props.description ?? siteConfig.description;
const canonicalUrl = `https://www.cubeyond.net${props.canonicalPath}`;
const pageType = props.pageType ?? "website";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl} />
    {
      props.publishedTime && (
        <meta property="article:published_time" content={props.publishedTime.toISOString()} />
      )
    }
    <meta name="theme-color" content="" />
    <noscript>
      <style>
        .lazy-list-sentinel {
          display: none !important;
        }
      </style>
    </noscript>
    <link rel="stylesheet" href={katexCssUrl} />
    <script is:inline>
      // 防闪烁：渲染前恢复主题（模板 FOUC-prevention script）
      (function () {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = stored ?? (prefersDark ? "dark" : "light");
        var root = document.firstElementChild;
        if (root) {
          root.setAttribute("data-theme", theme);
          root.classList.toggle("dark", theme === "dark");
        }
        window.__theme = { value: theme };
      })();
    </script>
  </head>
  <body>
    <Header volume={props.volume} slug={props.slug} />
    <slot />
    <Footer volume={props.volume} slug={props.slug} />

    <ThemeSwitcher current="paper" volume={props.volume} slug={props.slug} />

    <script>
      import { initThemeLazyLists } from "../../modules/themes/lazy-list-client";
      import { initThemeMermaid } from "../../modules/themes/mermaid-client";
      import { installImageLightbox } from "../../modules/textmode/lightbox/images";

      installImageLightbox();

      // 列表分批懒加载（无批次时为空操作）
      initThemeLazyLists();

      // mermaid 逐图懒渲染，渲染完成时自动安装对应灯箱
      initThemeMermaid("paper");
    </script>
  </body>
</html>
