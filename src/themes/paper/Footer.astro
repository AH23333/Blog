---
/**
 * paper 页脚（模板 Footer.astro 移植）。
 * Textmode / 切换风格 导航 + 版权 + Powered by Astro and AstroPaper。
 */

import { siteConfig } from "../../config";
import { themeUrl } from "../../modules/themes/theme-routes";

type Props = {
  volume?: number;
  slug?: string;
};

const props = Astro.props;
const textmodeHref = themeUrl("textmode", props.volume, props.slug);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-links">
      <a href={textmodeHref}>Textmode</a>
      <a href="/themes/">切换风格</a>
    </div>

    <div class="footer-copy">
      <span>&copy; {year} {siteConfig.name}</span>
      <span aria-hidden="true">&nbsp;|&nbsp;</span>
      <span>
        Powered by
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>
        and
        <a href="https://github.com/satnaing/astro-paper" target="_blank" rel="noopener noreferrer">AstroPaper</a>
      </span>
    </div>
  </div>
</footer>
