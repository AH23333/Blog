---
import BaseLayout from "../base/BaseLayout.astro";
import ThemeSwitcher from "../../modules/themes/ThemeSwitcher.astro";

type Props = {
  title?: string;
  tabTitle?: string;
  description?: string;
  preloadCjk?: boolean;
  pageType?: "website" | "article";
  publishedTime?: Date;
};

// 从当前路径解析卷/文章，供主题切换器同步浏览位置
// `/volume/0/xxx/` → volume=0, slug=xxx；`/volume/0/` → volume=0；其余 → 首页
// slug 解码：与主题页 themeUrl(phile.route.slug) 输出的解码形式保持一致
const pathMatch = Astro.url.pathname.match(/^\/volume\/(\d+)(?:\/([^/]+))?\/$/);
const currentVolume = pathMatch ? Number(pathMatch[1]) : undefined;
const rawSlug = pathMatch?.[2];
let currentSlug: string | undefined;
try {
  currentSlug = rawSlug ? decodeURIComponent(rawSlug) : undefined;
} catch {
  currentSlug = rawSlug;
}
---

<BaseLayout
  title={Astro.props.title}
  tabTitle={Astro.props.tabTitle}
  description={Astro.props.description}
  preloadCjk={Astro.props.preloadCjk}
  pageType={Astro.props.pageType}
  publishedTime={Astro.props.publishedTime}
>
  <!-- 返回按钮 -->
  <button id="nav-back" class="nav-btn" type="button" aria-label="返回上一页" title="返回上一页">
    &#x2190; BACK
  </button>

  <!-- 返回顶部按钮 -->
  <button id="scroll-top" class="nav-btn" type="button" aria-label="返回顶部" title="返回顶部">
    &#x2191; TOP
  </button>

  <!-- 主题风格入口按钮 -->
  <a id="nav-themes" class="nav-btn" href="/themes/" aria-label="选择阅读风格" title="选择阅读风格">
    &#x25CE; THEMES
  </a>

  <main class="screen">
    <slot />
  </main>

  <!-- 主题切换器：保持当前文章路径切换阅读风格 -->
  <ThemeSwitcher
    current="textmode"
    volume={currentVolume}
    slug={currentSlug}
    variant="textmode"
  />
</BaseLayout>

<script>
  // 返回上一页（首页隐藏）
  const backBtn = document.getElementById("nav-back");
  if (backBtn) {
    // 首页路径为 "/"（Astro 的 base 为 "/"）
    if (window.location.pathname === "/") {
      backBtn.style.display = "none";
    }

    backBtn.addEventListener("click", () => {
      if (document.referrer && new URL(document.referrer).origin === window.location.origin) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    });
  }

  // 返回顶部
  const topBtn = document.getElementById("scroll-top");
  if (topBtn) {
    const checkScroll = () => {
      topBtn.classList.toggle("visible", window.scrollY > 300);
    };

    window.addEventListener("scroll", checkScroll, { passive: true });
    checkScroll();

    topBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>

  <script>
  import { bootstrapTypewriter } from "@/modules/textmode/typewriter/install";
  bootstrapTypewriter();
</script>

<style is:global>
  /* 初始隐藏文本内容，防止打字动画前的闪烁 */
  .textmode-pre {
    visibility: hidden;
  }

  /* 导航按钮通用样式 */
  .nav-btn {
    position: fixed;
    z-index: 100;
    padding: 4px 10px;
    border: 1px solid var(--ansi-bright-black);
    background: var(--bg);
    color: var(--ansi-cyan);
    font-family: var(--text-font);
    font-size: var(--text-size);
    line-height: 1;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
  }

  .nav-btn:hover {
    opacity: 1;
    border-color: var(--link);
    color: var(--link);
    background: var(--link-hover-bg);
  }

  .nav-btn:focus-visible {
    opacity: 1;
    outline: 1px solid var(--link);
    outline-offset: 2px;
  }

  /* 返回按钮 - 左上角 */
  #nav-back {
    top: 8px;
    left: 8px;
  }

  /* 主题风格入口按钮 - 左下角 */
  #nav-themes {
    bottom: 12px;
    left: 8px;
    text-decoration: none;
  }

  /* 返回顶部按钮 - 右下角 */
  #scroll-top {
    bottom: 12px;
    right: 12px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  #scroll-top.visible {
    opacity: 0.6;
    pointer-events: auto;
  }

  #scroll-top.visible:hover {
    opacity: 1;
  }

  /* 打字机光标 */
  .typewriter-cursor {
    display: inline;
    color: var(--link);
    animation: cursor-blink 0.8s step-end infinite;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* 打字行淡入效果 */
  .tw-line {
    animation: line-fade-in 0.05s ease-out;
  }

  @keyframes line-fade-in {
    from { opacity: 0.3; }
    to { opacity: 1; }
  }

  /* ── 懒加载样式 ──────────────────────────────────────────────────────── */

  /*
   * display: contents 使这些包装容器在布局树中完全透明，
   * 其子元素表现得如同直接父元素就是 <article>，
   * 与非懒加载路径的 DOM 结构在布局层面完全一致。
   */
  .lazy-initial-content,
  .lazy-chunk-initial,
  .lazy-pending-content {
    display: contents;
  }

  /* 懒加载占位元素 - 使用 CSS 变量控制高度，平滑过渡 */
  .lazy-placeholder {
    display: block;
    min-height: var(--placeholder-height, 80px);
    margin: 0;
    contain: layout style;
    transition: opacity 0.15s ease-out;
  }

  /* 模板元素（不可见，不占用布局空间） */
  .lazy-template {
    display: none;
  }
</style>